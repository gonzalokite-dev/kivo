---
/** La tarjeta del traspaso: vendedor -> coche -> comprador.
 * Motivo 1 del brandbook (la flecha del traspaso): una sola por pantalla,
 * siempre de izquierda a derecha. */
interface Props {
  lang?: 'es' | 'en';
}
const en = Astro.props.lang === 'en';
const T = en
  ? { aria: 'Example of a car transfer between two people', vende: 'sells', compra: 'buys', chip: 'Transferred at the DGT', sub: 'No appointment · no digital certificate' }
  : { aria: 'Ejemplo de transferencia de un coche entre dos personas', vende: 'vende', compra: 'compra', chip: 'Transferido en la DGT', sub: 'Sin cita · sin certificado digital' };
---

        <div class="transfer" aria-label={T.aria}>
          <div class="tf-row">
            <div class="person"><span class="avatar v">L</span><b>Laura</b><span>{T.vende}</span></div>
            <div class="carmove">
              <svg class="tf-svg" width="150" height="72" viewBox="0 0 150 72" aria-hidden="true">
                <path d="M10 34C30 6 120 6 140 30" fill="none" stroke="#ffd84d" stroke-width="5" stroke-linecap="round" stroke-dasharray="1 11"/>
                <path d="M128 28L141 31L144 18" fill="none" stroke="#ffd84d" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
                <g transform="translate(43 30)">
                  <path d="M10 22L17 11Q19 8 23 8L41 8Q45 8 47 11L54 22Z" fill="#3d5afe"/>
                  <rect x="0" y="20" width="64" height="16" rx="7" fill="#3d5afe"/>
                  <path d="M16 21L20 13H30V21Z M34 21V13H44L48 21Z" fill="#e8edff"/>
                  <circle cx="15" cy="37" r="7" fill="#3d5afe" stroke="#ffffff" stroke-width="3"/>
                  <circle cx="49" cy="37" r="7" fill="#3d5afe" stroke="#ffffff" stroke-width="3"/>
                </g>
              </svg>
              <span class="plate"><i></i>1234 MBC</span>
            </div>
            <div class="person"><span class="avatar c">J</span><b>Javi</b><span>{T.compra}</span></div>
          </div>
          <div class="tf-status">
            <span class="chip-dgt"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{T.chip}</span>
            <span>{T.sub}</span>
          </div>
        </div>
