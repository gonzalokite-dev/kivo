---
/**
 * Sección completa de documentación: listas por comprador y vendedor,
 * ejemplos ilustrados de DNI, permiso de circulación y ficha técnica, cómo
 * hacer las fotos, cómo enviarlas y los casos especiales.
 *
 * Viene entera de referencia/kivo-landing.html. Los casos especiales ahora
 * enlazan a su guía.
 */
import SpriteDocs from "./SpriteDocs.astro";
import CasosEspeciales from "./CasosEspeciales.astro";

interface Props {
  /** La portada enseña solo el resumen; esta página, todo. */
  titulo?: string;
  entradilla?: string;
}
const {
  titulo = "Qué tenéis que enviarnos para la transferencia",
  entradilla = "Fotos con el móvil de tres documentos y una firma online. El contrato, el impuesto y la tasa de Tráfico los preparamos nosotros.",
} = Astro.props;
---

<SpriteDocs />

<div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">Documentación</span>
    <h2>{titulo}</h2>
    <p>{entradilla}</p>
  </div>

      <div class="doc-sum">
        <div class="who-card">
          <div class="who-h"><span class="avatar c" aria-hidden="true">J</span><div><b>El comprador</b><span>Quien se queda el coche</span></div></div>
          <ul class="tick">
            <li><label><input type="checkbox"><span>DNI o NIE, por las dos caras<small>También vale la tarjeta de residencia (TIE) o el pasaporte con NIE.</small></span></label></li>
            <li><label><input type="checkbox"><span class="sign">Firma online del contrato y del mandato<small>Desde el móvil, cuando te enviemos el enlace por email.</small></span></label></li>
          </ul>
        </div>
        <div class="who-card">
          <div class="who-h"><span class="avatar v" aria-hidden="true">L</span><div><b>El vendedor</b><span>Quien figura hoy como titular</span></div></div>
          <ul class="tick">
            <li><label><input type="checkbox"><span>DNI o NIE, por las dos caras</span></label></li>
            <li><label><input type="checkbox"><span>Permiso de circulación<small>El documento entero, por delante.</small></span></label></li>
            <li><label><input type="checkbox"><span>Ficha técnica con la ITV en vigor<small>Si es de papel: la hoja con el último sello de la ITV.</small></span></label></li>
            <li><label><input type="checkbox"><span class="sign">Firma online del contrato y del mandato<small>Desde el móvil, cuando le enviemos el enlace por email.</small></span></label></li>
          </ul>
        </div>
      </div>

      <div class="doc-list">
        <article class="doc">
          <figure class="shot dni">
            <span class="tag-ej">Ejemplo · delante y detrás</span>
            <svg viewBox="0 0 856 540" role="img" aria-label="DNI de ejemplo por delante: foto, apellidos, nombre, número y validez"><use href="#dni-a"/></svg>
            <svg viewBox="0 0 856 540" role="img" aria-label="DNI de ejemplo por detrás: domicilio y las tres líneas de caracteres de abajo"><use href="#dni-b"/></svg>
          </figure>
          <div class="doc-txt">
            <div class="pills"><span class="pill">Comprador</span><span class="pill">Vendedor</span><span class="pill y">2 fotos: delante y detrás</span></div>
            <h3>DNI o NIE de los dos</h3>
            <p>Con él identificamos a comprador y vendedor en el contrato y ante la DGT. Tiene que estar en vigor.</p>
            <ul class="keys">
              <li><code>Delante</code><span>Que se lean el número, el nombre y la fecha de validez.</span></li>
              <li><code>Detrás</code><span>Que salgan enteras las tres líneas de letras y números de abajo.</span></li>
            </ul>
            <p class="alt"><b>¿Eres extranjero?</b> Vale la tarjeta de residencia (TIE) o el pasaporte junto al certificado de NIE.</p>
          </div>
        </article>

        <article class="doc">
          <figure class="shot paper">
            <span class="tag-ej">Ejemplo</span>
            <svg viewBox="0 0 600 840" role="img" aria-label="Permiso de circulación de ejemplo con la matrícula, el titular y el número de bastidor marcados">
              <g font-family="'DM Sans',Arial,sans-serif">
                <rect x="1" y="1" width="598" height="838" rx="6" fill="#edf5ea" stroke="#b9cdb4" stroke-width="2"/>
                <g stroke="#bcd6b6" opacity=".7"><use href="#wv" transform="scale(.7 1)" y="150"/><use href="#wv" transform="scale(.7 1)" y="330"/><use href="#wv" transform="scale(.7 1)" y="510"/><use href="#wv" transform="scale(.7 1)" y="690"/></g>
                <text x="300" y="46" text-anchor="middle" font-size="14" font-weight="700" fill="#2f5a3a" letter-spacing="2.5">REINO DE ESPAÑA</text>
                <text x="300" y="68" text-anchor="middle" font-size="14" font-weight="700" fill="#2f5a3a" letter-spacing="2.5">DIRECCIÓN GENERAL DE TRÁFICO</text>
                <text x="300" y="106" text-anchor="middle" font-size="31" font-weight="800" fill="#1f3d29" letter-spacing="1">PERMISO DE CIRCULACIÓN</text>
                <path d="M30 128H570" stroke="#2f5a3a" stroke-width="2"/>
                <rect x="26" y="146" width="262" height="62" rx="10" fill="#ffd84d" fill-opacity=".3" stroke="#e6b800" stroke-width="3"/>
                <rect x="26" y="290" width="548" height="134" rx="10" fill="#ffd84d" fill-opacity=".3" stroke="#e6b800" stroke-width="3"/>
                <rect x="26" y="506" width="548" height="62" rx="10" fill="#ffd84d" fill-opacity=".3" stroke="#e6b800" stroke-width="3"/>
                <g stroke="#c6dac0" stroke-width="1.5"><path d="M40 222H560M40 294H560M40 438H560M40 510H560M40 582H560M40 654H560"/></g>
                <g font-size="13" fill="#4d6b55">
                  <text x="40" y="170"><tspan font-weight="800" fill="#1f3d29">A</tspan>  Matrícula</text>
                  <text x="320" y="170"><tspan font-weight="800" fill="#1f3d29">B</tspan>  Primera matriculación</text>
                  <text x="40" y="244"><tspan font-weight="800" fill="#1f3d29">I</tspan>  Fecha de esta matriculación</text>
                  <text x="320" y="244"><tspan font-weight="800" fill="#1f3d29">J</tspan>  Categoría</text>
                  <text x="40" y="314"><tspan font-weight="800" fill="#1f3d29">C.1.1</tspan>  Apellidos</text>
                  <text x="320" y="314"><tspan font-weight="800" fill="#1f3d29">C.1.2</tspan>  Nombre</text>
                  <text x="40" y="386"><tspan font-weight="800" fill="#1f3d29">C.1.3</tspan>  Domicilio</text>
                  <text x="40" y="460"><tspan font-weight="800" fill="#1f3d29">D.1</tspan>  Marca</text>
                  <text x="320" y="460"><tspan font-weight="800" fill="#1f3d29">D.3</tspan>  Denominación comercial</text>
                  <text x="40" y="530"><tspan font-weight="800" fill="#1f3d29">E</tspan>  Número de identificación (bastidor)</text>
                  <text x="40" y="604"><tspan font-weight="800" fill="#1f3d29">P.3</tspan>  Combustible</text>
                  <text x="320" y="604"><tspan font-weight="800" fill="#1f3d29">S.1</tspan>  Plazas</text>
                </g>
                <g font-size="23" font-weight="700" fill="#12261a">
                  <text x="40" y="198" letter-spacing="2">1234 MBC</text><text x="320" y="198">14/03/2017</text>
                  <text x="40" y="272">02/06/2021</text><text x="320" y="272">M1</text>
                  <text x="40" y="342">MARTÍN GÓMEZ</text><text x="320" y="342">LAURA</text>
                  <text x="40" y="414">C/ EJEMPLO 1, 28001 MADRID</text>
                  <text x="40" y="488">SEAT</text><text x="320" y="488">IBIZA</text>
                  <text x="40" y="558" letter-spacing="1.5">VSSZZZKJZHR000000</text>
                  <text x="40" y="632">GASOLINA</text><text x="320" y="632">5</text>
                </g>
                <rect x="40" y="680" width="112" height="112" fill="#fff"/>
                <rect x="48" y="688" width="96" height="96" fill="url(#p-qr)"/>
                <text x="176" y="708" font-size="15" font-weight="700" fill="#1f3d29">Solo es válido con la ITV en vigor</text>
                <text x="176" y="734" font-size="13" fill="#4d6b55">Nº de documento 0000000000</text>
                <text x="176" y="758" font-size="13" fill="#4d6b55">Documento de ejemplo, sin validez</text>
                <text x="300" y="470" transform="rotate(-32 300 420)" text-anchor="middle" font-size="104" font-weight="800" fill="#c62f22" opacity=".14" letter-spacing="6">EJEMPLO</text>
              </g>
            </svg>
          </figure>
          <div class="doc-txt">
            <div class="pills"><span class="pill">Vendedor</span><span class="pill y">1 foto: el documento entero</span></div>
            <h3>Permiso de circulación</h3>
            <p>Es el papel que va con el coche, normalmente en la guantera, y dice a nombre de quién está. Con él comprobamos que quien vende es el titular y qué coche se transfiere.</p>
            <ul class="keys">
              <li><code>A</code><span>Matrícula del coche.</span></li>
              <li><code>C.1</code><span>Titular actual: tiene que ser el vendedor.</span></li>
              <li><code>E</code><span>Número de bastidor, el que identifica el coche.</span></li>
            </ul>
            <p class="alt"><b>¿No lo encuentras?</b> Avísanos antes de pagar y vemos contigo cómo pedir un duplicado.</p>
          </div>
        </article>

        <article class="doc">
          <figure class="shot paper">
            <span class="tag-ej">Ejemplo</span>
            <svg viewBox="0 0 600 840" role="img" aria-label="Ficha técnica de ejemplo con la última ITV favorable marcada">
              <g font-family="'DM Sans',Arial,sans-serif">
                <rect x="1" y="1" width="598" height="838" rx="6" fill="#f7f2e3" stroke="#d9cfb2" stroke-width="2"/>
                <text x="300" y="56" text-anchor="middle" font-size="23" font-weight="800" fill="#3b3424">TARJETA DE INSPECCIÓN TÉCNICA</text>
                <text x="300" y="84" text-anchor="middle" font-size="14" font-weight="700" fill="#6d6247" letter-spacing="2.5">DE VEHÍCULOS · FICHA TÉCNICA</text>
                <path d="M30 104H570" stroke="#3b3424" stroke-width="2"/>
                <g font-size="13.5" fill="#6d6247"><text x="40" y="140">Marca</text><text x="40" y="178">Denominación comercial</text><text x="40" y="216">Bastidor</text><text x="40" y="254">Combustible</text><text x="40" y="292">Potencia</text><text x="40" y="330">Masa máxima</text><text x="40" y="368">Plazas</text></g>
                <g font-size="19" font-weight="700" fill="#2b2618"><text x="250" y="140">SEAT</text><text x="250" y="178">IBIZA</text><text x="250" y="216">VSSZZZKJZHR000000</text><text x="250" y="254">GASOLINA</text><text x="250" y="292">70 kW</text><text x="250" y="330">1.570 kg</text><text x="250" y="368">5</text></g>
                <g stroke="#e2d7b8" stroke-width="1.5"><path d="M40 154H560M40 192H560M40 230H560M40 268H560M40 306H560M40 344H560M40 382H560"/></g>
                <text x="40" y="436" font-size="15" font-weight="800" fill="#3b3424" letter-spacing="2.5">INSPECCIONES PERIÓDICAS</text>
                <g font-size="12.5" fill="#6d6247"><text x="40" y="470">Fecha</text><text x="210" y="470">Resultado</text><text x="440" y="470">Próxima</text></g>
                <path d="M40 482H560" stroke="#3b3424" stroke-width="1.5"/>
                <rect x="26" y="644" width="548" height="74" rx="10" fill="#ffd84d" fill-opacity=".32" stroke="#e6b800" stroke-width="3"/>
                <g font-size="20" font-weight="700" fill="#2b2618"><text x="40" y="530">03/2021</text><text x="440" y="530">03/2023</text><text x="40" y="606">03/2023</text><text x="440" y="606">03/2025</text><text x="40" y="688">03/2025</text><text x="440" y="688">03/2027</text></g>
                <g fill="none" stroke="#2d4fa3" stroke-width="3" opacity=".85">
                  <g transform="translate(310 523) rotate(-7)"><rect x="-86" y="-24" width="172" height="42" rx="8"/></g>
                  <g transform="translate(306 599) rotate(4)"><rect x="-86" y="-24" width="172" height="42" rx="8"/></g>
                  <g transform="translate(312 681) rotate(-4)"><rect x="-86" y="-24" width="172" height="42" rx="8"/></g>
                </g>
                <g font-size="17" font-weight="800" fill="#2d4fa3" letter-spacing="2" text-anchor="middle" opacity=".85">
                  <text transform="translate(310 530) rotate(-7)">FAVORABLE</text>
                  <text transform="translate(306 606) rotate(4)">FAVORABLE</text>
                  <text transform="translate(312 688) rotate(-4)">FAVORABLE</text>
                </g>
                <g stroke="#e2d7b8" stroke-width="1.5"><path d="M40 560H560M40 636H560M40 726H560"/></g>
                <text x="40" y="780" font-size="13" fill="#6d6247">Documento de ejemplo, sin validez</text>
                <text x="300" y="470" transform="rotate(-32 300 420)" text-anchor="middle" font-size="104" font-weight="800" fill="#c62f22" opacity=".14" letter-spacing="6">EJEMPLO</text>
              </g>
            </svg>
          </figure>
          <div class="doc-txt">
            <div class="pills"><span class="pill">Vendedor</span><span class="pill y">1 foto: la hoja de la última ITV</span></div>
            <h3>Ficha técnica con la ITV en vigor</h3>
            <p>El permiso de circulación nuevo solo vale si la ITV está en vigor. Si la ficha es de papel, haz la foto de la hoja donde está el último sello.</p>
            <ul class="keys">
              <li><code>ITV</code><span>Última inspección favorable y fecha de la próxima, que no tiene que haber pasado.</span></li>
            </ul>
            <p class="alt"><b>¿Tu ficha técnica es electrónica?</b> Entonces no hay papel que fotografiar: dínoslo y la consultamos con la matrícula.</p>
          </div>
        </article>
      </div>

      <div class="prep">
        <div><span class="eyebrow">Esto no tenéis que buscarlo</span><h3>Lo preparamos nosotros</h3></div>
        <ul class="ours-grid">
          <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg><b>Informe de la DGT</b><span>Vemos cargas, embargos e ITV antes de nada.</span></li>
          <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h7M9 17h5"/></svg><b>Contrato y mandato</b><span>Los redactamos con vuestros datos. Solo tenéis que firmar.</span></li>
          <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/></svg><b>Impuesto (modelo 620)</b><span>Liquidamos el ITP en tu comunidad y te enviamos el justificante.</span></li>
          <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17h14l-1.5-6h-11z"/><circle cx="8" cy="18" r="1.5"/><circle cx="16" cy="18" r="1.5"/><path d="M7 11l1.5-4h7L17 11"/></svg><b>Tasa y presentación</b><span>Pagamos la tasa de 55,70 € y presentamos la transferencia en la DGT.</span></li>
        </ul>
      </div>

      <div class="howto">
        <div class="tips">
          <h3>Cómo hacer las fotos para que valgan a la primera</h3>
          <ul class="ex">
            <li class="ok"><span class="frame"><svg viewBox="0 0 400 300" role="img" aria-label="Bien: documento entero y nítido"><use href="#dni-a" x="40" y="49" width="320" height="202"/></svg></span><span class="cap"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Entero y nítido</span></li>
            <li class="ko"><span class="frame"><svg viewBox="0 0 400 300" role="img" aria-label="Mal: documento cortado"><use href="#dni-a" x="130" y="96" width="420" height="265"/></svg></span><span class="cap"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>Cortado</span></li>
            <li class="ko"><span class="frame"><svg viewBox="0 0 400 300" role="img" aria-label="Mal: reflejo del flash"><use href="#dni-a" x="40" y="49" width="320" height="202"/><ellipse cx="232" cy="128" rx="104" ry="64" fill="url(#g-glare)"/></svg></span><span class="cap"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>Con reflejo</span></li>
            <li class="ko"><span class="frame"><svg viewBox="0 0 400 300" role="img" aria-label="Mal: foto movida"><use href="#dni-a" x="40" y="49" width="320" height="202" filter="url(#f-blur)"/></svg></span><span class="cap"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>Movida</span></li>
          </ul>
          <ul class="rules">
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Documento entero, con las cuatro esquinas a la vista.</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Sobre una mesa lisa, con luz de día y sin flash.</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Si haces zoom y no se lee, repítela.</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Una foto por cara, sin recortes ni filtros.</li>
          </ul>
        </div>
        <div class="send">
          <h3>Cómo nos las enviáis</h3>
          <ol>
            <li><span>Cuando nos envías la solicitud, en menos de 24 horas te llega <b>un email nuestro con la matrícula en el asunto</b>.</span></li>
            <li><span><b>Responde con las fotos adjuntas.</b> El vendedor envía las suyas respondiendo al email que le mandamos a él.</span></li>
            <li><span>Te confirmamos en el mismo hilo que todo está bien, o <b>te decimos qué foto repetir</b>.</span></li>
          </ol>
          <p class="fine">JPG, PNG o PDF. Usamos tus documentos solo para tramitar tu transferencia.</p>
        </div>
      </div>


      <CasosEspeciales />
</div>
