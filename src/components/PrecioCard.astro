---
/**
 * La tarjeta de 89 EUR y lo que incluye, en lista de beneficios con la frase
 * clave en negrita (patrón de las tarjetas de plan de Taxfix). El encabezado
 * lo pone la página. Solo cosas que el servicio ya hace según el resto de la web.
 */
import Icono from './Icono.astro';

interface Props {
  /** A dónde lleva «Ver mi total»: la calculadora de la página o la de /calcular-transferencia-coche/. */
  cta?: string;
}
const { cta = '#calculadora' } = Astro.props;

const incluye = [
  ['Sin colas ni cita en Tráfico', 'presentamos la transferencia online, como gestores.'],
  ['Informe del vehículo', 'comprobamos cargas, embargos e ITV antes de pagar nada.'],
  ['Contrato de compraventa', 'lo redactamos con vuestros datos y lo firmáis desde el móvil.'],
  ['Mandato al gestor', 'para que podamos presentarlo en vuestro nombre, sin certificado digital.'],
  ['Impuesto (ITP) calculado y pagado', 'con el valor de tablas de Hacienda, para evitar complementarias.'],
  ['Tasa de la DGT pagada', 'al céntimo y sin recargo, con su justificante.'],
  ['Cambio de titular en la DGT', 'y te mandamos el permiso de circulación a tu nombre.'],
  ['Un email en cada paso', 'con la matrícula en el asunto: sabes cómo va sin llamar a nadie.'],
];
---

<div class="price">
  <div class="price-card">
    <span class="eyebrow">Honorarios, IVA incluido</span>
    <span class="num">89<small>€</small></span>
    <p>
      Igual para cualquier coche o moto. La tasa DGT y el ITP los pagamos por ti y te los enseñamos
      al céntimo, sin margen.
    </p>
    <a class="btn" href={cta}>Ver mi total</a>
    <span class="price-nota">Sin pagar nada ahora · Respuesta en menos de 24 h</span>
  </div>
  <div class="incluye">
    <b>Todo esto va incluido</b>
    <ul>
      {
        incluye.map(([t, d]) => (
          <li>
            <Icono name="check" size={18} sw={3} />
            <span>
              <b>{t}:</b> {d}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .incluye {
    background: var(--surface);
    border-radius: var(--r-lg);
    padding: 30px 32px;
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .incluye > b {
    font: 800 20px/1.2 var(--f-d);
    letter-spacing: -0.01em;
  }
  .incluye ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .incluye li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    align-items: start;
    color: var(--tinta-suave);
    font-size: 15.5px;
  }
  .incluye li :global(svg) {
    color: var(--ok);
    margin-top: 3px;
  }
  .incluye li b {
    color: var(--tinta);
    font-weight: 700;
  }
  .price-nota {
    font-size: 13px;
    color: var(--on-asfalto-suave);
  }
  @media (max-width: 520px) {
    .incluye {
      padding: 24px 20px;
    }
  }
</style>
