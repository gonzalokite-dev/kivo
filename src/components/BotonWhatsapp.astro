---
/**
 * Botón flotante de WhatsApp, siempre visible en móvil.
 *
 * Solo se renderiza si hay un número real en `WHATSAPP` (site.config.mjs).
 * Sin número no se inventa uno: el componente no pinta nada, igual que la
 * calculadora no envía el formulario sin PUBLIC_FORM_ENDPOINT.
 */
import { waLink } from '../data/whatsapp';

interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;

const href = waLink(lang);
---

{
  href && (
    <a class="wa-flotante" href={href} target="_blank" rel="noopener" aria-label={lang === 'en' ? 'Message us on WhatsApp' : 'Escríbenos por WhatsApp'}>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.6 6.3A8.9 8.9 0 0 0 3.1 16.9L2 22l5.3-1.4A9 9 0 0 0 12 21.9 8.9 8.9 0 0 0 17.6 6.3Zm-5.6 13.7a7.3 7.3 0 0 1-3.8-1l-.3-.2-3 .8.8-2.9-.2-.3a7.4 7.4 0 1 1 13.1-4.6 7.4 7.4 0 0 1-6.6 8.2Zm4-5.5c-.2-.1-1.3-.6-1.5-.7-.2-.1-.3-.1-.5.1l-.6.8c-.1.2-.2.2-.4.1a6 6 0 0 1-2.9-2.6c-.2-.3 0-.4.1-.6l.4-.5c.1-.2.1-.3 0-.5l-.6-1.5c-.2-.4-.4-.3-.5-.3h-.5c-.2 0-.4.1-.6.3a2 2 0 0 0-.6 1.5c0 .9.6 1.8 1.6 3a9.3 9.3 0 0 0 3.6 3.2c.5.2.9.3 1.2.4.5.1 1 .1 1.3-.1.4-.2.7-.7.8-1.2a1 1 0 0 0 0-.7c0-.1-.2-.2-.3-.2Z"/>
      </svg>
    </a>
  )
}

<style>
  .wa-flotante {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 45;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #25d366;
    color: #fff;
    box-shadow: 0 4px 16px rgba(14, 22, 48, 0.28);
  }
  .wa-flotante:hover {
    background: #1fb855;
  }
  /* En móvil, encima de la barra fija pero sin tapar el botón principal. */
  @media (max-width: 1000px) {
    .wa-flotante {
      right: 12px;
      bottom: calc(86px + env(safe-area-inset-bottom, 0px));
      width: 50px;
      height: 50px;
    }
  }
</style>
