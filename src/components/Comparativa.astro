---
/** Kivo o hacerlo tú: tabla de tres columnas (concepto, por tu cuenta, Kivo).
 * En escritorio es una tabla estrecha y centrada; por debajo de 640 px cada
 * fila se convierte en una tarjeta con Kivo primero (ver `.cmp` en global.css). */
interface Props {
  /** Solo la tabla y la nota, para páginas que ya tienen su propio H2.
   *  El .wrap lo pone siempre la página. */
  soloTabla?: boolean;
}
const { soloTabla = false } = Astro.props;

const COLS = ['Por tu cuenta en la DGT', 'Kivo, online'];
const FILAS: [string, string, string][] = [
  ['Honorarios', '0 €', '89 €, IVA incluido'],
  ['Desplazamientos', 'Jefatura de Tráfico con cita, o trámite online', 'Ninguno'],
  ['Certificado digital', 'Lo necesitáis los dos para hacerlo online', 'No hace falta'],
  ['Cálculo del ITP', 'Lo haces tú con las tablas de Hacienda', 'Incluido y visible antes de pagar'],
  ['Seguimiento', 'Consultas tú en la DGT', 'Te escribimos por email en cada paso'],
];
---

{
  !soloTabla && (
    <div class="sec-head">
      <span class="eyebrow">Compara</span>
      <h2>Hacerlo tú o con Kivo</h2>
      <p>Hacerlo tú sale más barato si los dos tenéis certificado digital y tiempo.</p>
    </div>
  )
}
<div class="cmp-caja">
  <div class="tbl cmp">
    <table>
      <thead>
        <tr>
          <th scope="col"><span class="visually-hidden">Concepto</span></th>
          <th scope="col">{COLS[0]}</th>
          <th scope="col" class="us">{COLS[1]}</th>
        </tr>
      </thead>
      <tbody>
        {
          FILAS.map(([concepto, tu, kivo]) => (
            <tr>
              <th scope="row">{concepto}</th>
              <td data-col={COLS[0]}>{tu}</td>
              <td data-col="Kivo" class="us">{kivo}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="src">La tasa de la DGT y el impuesto son los mismos en las dos opciones.</p>
</div>

<style>
  .cmp-caja {
    max-width: 860px;
    margin-inline: auto;
  }
  .cmp-caja .src {
    text-align: center;
  }
  /* En escritorio, tabla estrecha con columnas proporcionadas. En móvil
     manda el diseño de tarjetas de global.css. */
  @media (min-width: 641px) {
    .cmp-caja :global(table) {
      min-width: 0;
      table-layout: fixed;
    }
    .cmp-caja :global(th:first-child) {
      width: 26%;
    }
  }
</style>
