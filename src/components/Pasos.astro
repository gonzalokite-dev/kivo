---
/** La carretera de pasos (motivo 2 del brandbook) y los 6 emails de
 * seguimiento. El ultimo paso va en amarillo: es el final del camino.
 * No lleva .wrap: lo pone la página que lo usa. */
interface Props {
  /** Sin el encabezado, para páginas que ya tienen su propio H2. */
  sinCabecera?: boolean;
}
const { sinCabecera = false } = Astro.props;
---

      {!sinCabecera && <div class="sec-head"><span class="eyebrow">Cómo funciona</span><h2>Tu transferencia en 3 paradas</h2><p>Desde el móvil, sin citas ni colas.</p></div>}
      <div class="road-wrap">
        <div class="road" aria-hidden="true"></div>
        <ol class="steps">
          <li class="step"><span class="pin">1</span><span class="who">Tú · 2 minutos</span><h3>Calcula y pídela</h3><p>Ves el total con el impuesto de tu comunidad y nos dejas tus datos. Te escribimos en menos de 24 horas.</p></li>
          <li class="step"><span class="pin">2</span><span class="who">Comprador y vendedor</span><h3>Fotos y firma en el móvil</h3><p>DNI de los dos, permiso de circulación y ficha técnica. Firmáis el contrato y el mandato online. <a href="/documentacion-transferencia-coche/">Ver qué fotos hacen falta</a></p></li>
          <li class="step"><span class="pin"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span><span class="who">Nosotros</span><h3>Transferido en la DGT</h3><p>Pagamos el ITP, presentamos el cambio de titular y te enviamos el permiso a tu nombre.</p></li>
        </ol>
      </div>
      <div class="mails">
        <div><span class="eyebrow">Seguimiento</span><h3>Sabes en qué punto está tu coche sin llamar a nadie</h3><p>Envías la solicitud y en menos de 24 horas te escribe una persona del equipo. Desde ahí, un email en cada paso; si tienes que hacer algo, te lo decimos en la primera línea.</p></div>
        <div class="inbox"><ul>
          <li><i>1</i><div><b>1234 MBC · Empezamos tu transferencia</b><span>Una persona del equipo te dice qué fotos enviar</span></div><em>Menos de 24 h</em></li>
          <li><i>2</i><div><b>1234 MBC · Fotos recibidas</b><span>O cuál hay que repetir</span></div><em>Día 1</em></li>
          <li><i>3</i><div><b>1234 MBC · Firma el contrato (2 minutos)</b><span>Enlace de firma para los dos</span></div><em>Día 1–2</em></li>
          <li><i>4</i><div><b>1234 MBC · Impuesto pagado</b><span>Con el justificante</span></div><em>Día 2–3</em></li>
          <li><i>5</i><div><b>1234 MBC · Presentada en la DGT</b><span>Ya solo depende de Tráfico</span></div><em>Día 3–4</em></li>
          <li><i>6</i><div><b>1234 MBC · Transferido. El coche ya está a tu nombre</b><span>Con el permiso de circulación nuevo</span></div><em>Tráfico</em></li>
        </ul></div>
      </div>
