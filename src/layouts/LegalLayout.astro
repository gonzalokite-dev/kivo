---
/**
 * Plantilla de página legal. Los textos están redactados con los datos de
 * la sociedad (site.config.mjs) pero son un borrador: los tiene que revisar
 * quien asuma la responsabilidad legal. Mientras la ruta esté en DRAFT_PATHS
 * van con noindex, fuera del sitemap y con el aviso de borrador visible.
 */
import BaseLayout from './BaseLayout.astro';
import Migas from '../components/Migas.astro';
import { breadcrumbLd, type Miga } from '../data/seo';
import { DRAFT_PATHS } from '../../site.config.mjs';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  etiqueta: string;
  /** Fecha de la última revisión del texto. */
  actualizado?: string;
}
const { title, description, path, h1, etiqueta, actualizado = 'noviembre de 2026' } = Astro.props;
const borrador = DRAFT_PATHS.includes(path);

const migas: Miga[] = [
  { label: 'Inicio', href: '/' },
  { label: etiqueta, href: path },
];
---

<BaseLayout {title} {description} {path} noindex={borrador} jsonld={[breadcrumbLd(migas)]}>
  <section class="phead">
    <div class="wrap">
      <Migas {migas} />
      <h1>{h1}</h1>
      <p class="hint">Última actualización: {actualizado}</p>
    </div>
  </section>

  <section style="padding-top:40px">
    <div class="wrap">
      <!-- VALIDAR: el texto está redactado pero lo tiene que revisar el
           responsable legal. Cuando esté aprobado, quitar la ruta de
           DRAFT_PATHS en site.config.mjs: desaparece este aviso, se quita el
           noindex y entra en el sitemap. -->
      {
        borrador && (
          <div class="draft">
            <b>Borrador para revisar</b>
            <p>
              El texto está redactado con los datos de la sociedad, pero falta la revisión del
              responsable legal. No es definitivo y esta página no está indexada en Google.
            </p>
          </div>
        )
      }

      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
